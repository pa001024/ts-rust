{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "preserve"
	},
	"include": ["src"],
	"contentMappers": [
		{
			"package": "tsc-rs-vue-mapper",
			"extensions": [".vue"]
		}
	]
}
